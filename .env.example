# Copy to .env.local and fill in values. Never commit .env.local.
# See README "Configuration" for details.

# --- Database (required for auth, jobs, applications) ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
MONGODB_DB_NAME=jobtrackr_db

# --- Auth (required) ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=change-me-to-a-long-random-string
NEXTAUTH_URL=http://localhost:3000

# --- AI (optional but required for resume + chat features) ---
GEMINI_API_KEY=

# --- Python resume NLP backend (optional; Next.js Gemini path works without it) ---
# Local Flask: http://localhost:5001/analyze
PYTHON_BACKEND_URL=http://localhost:5001/analyze
